APP_NAME="iKontrol Admin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.ikontrol.solutions

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tws001_ikontroladmin
DB_USERNAME=tws001
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

IKONTROL_DB_HOST=localhost
IKONTROL_DB_PORT=3306
IKONTROL_DB_USERNAME=tws001
IKONTROL_DB_PASSWORD=
IKONTROL_DB_PREFIX=tws001_ik_
IKONTROL_DB_TABLE_PREFIX=ikontrol_
IKONTROL_INSTANCES_ROOT=/home/tws001
IKONTROL_FOLDER_SUFFIX=.ikontrol.solutions
IKONTROL_VERSION_ARCHIVE_ROOT=/home/tws001/ikontrol-version-archives
IKONTROL_TEMPLATE_ROOT=/home/tws001/ikontrol-templates
IKONTROL_MYSQL_BINARY=mysql
IKONTROL_DEPLOYMENT_TIMEOUT=300
IKONTROL_PHP_BINARY=
IKONTROL_GITHUB_REPOSITORY=triple-w/ikontrol-platform
IKONTROL_GITHUB_TOKEN=
IKONTROL_GITHUB_API_URL=https://api.github.com
IKONTROL_RELEASE_MANIFEST_MAX_BYTES=262144
IKONTROL_CANONICAL_VERSION=1.1.5
IKONTROL_RELEASE_ARTIFACT_ROOT=/home/tws001/ikontrol-release-artifacts
IKONTROL_RELEASE_STAGING_ROOT=/home/tws001/ikontrol-release-staging
IKONTROL_RELEASE_BACKUP_ROOT=/home/tws001/ikontrol-release-backups
IKONTROL_RELEASE_MAX_ARCHIVE_BYTES=536870912
IKONTROL_RELEASE_MAX_EXTRACTED_BYTES=1073741824
IKONTROL_RELEASE_MAX_FILES=50000

CPANEL_HOST=
CPANEL_PORT=2083
CPANEL_USERNAME=tws001
CPANEL_API_TOKEN=

FC2_DB_HOST=
FC2_DB_PORT=3306
FC2_DB_DATABASE=tws001_factucare
FC2_DB_USERNAME=
FC2_DB_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ikontrol.solutions"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
