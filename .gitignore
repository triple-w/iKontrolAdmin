# Environment and secrets
.env
.env.*
!.env.example
/auth.json
*.key
*.pem

# PHP dependencies (installed by Composer on each environment)
/vendor/

# Frontend dependencies; production receives the compiled public/build output
/node_modules/
/public/hot
/public/storage

# Runtime files
/storage/*.key
/storage/pail/
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/.phpunit.cache/
/.phpunit.result.cache
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*

# Local tooling and IDEs
/.fleet/
/.idea/
/.nova/
/.vscode/
/.zed/
/.phpactor.json
/docker-compose.override.yml
/Homestead.json
/Homestead.yaml

# Legacy build systems (Vite output in public/build is intentionally versioned)
/public/css/
/public/js/
/public/mix-manifest.json

# Vuexy source artifacts intentionally excluded from this distribution
/resources/assets/vendor/fonts/flags/**
/resources/assets/vendor/fonts/fontawesome/**
